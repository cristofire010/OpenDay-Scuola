# Database Postgres (Neon, Supabase, Vercel Postgres, o locale)
DATABASE_URL=postgres://utente:password@host:5432/openday

# Password dell'area riservata (/staff e /admin). Obbligatoria.
STAFF_PASSWORD=cambia-questa-password

# Gli account dei tutor (nome utente + password) si creano dall'area
# riservata /admin, non da variabili d'ambiente.

# Chiave per firmare le sessioni. Genera una stringa casuale lunga:
#   openssl rand -base64 32
SESSION_SECRET=

# URL pubblico del sito, usato per i QR (es. https://openday.scuola.it).
# Se manca, viene ricavato dalla richiesta: su rete locale il QR usa
# l'IP attuale della macchina, quindi non serve impostarlo.
# Un SITE_URL con un indirizzo IP viene ignorato (gli IP di rete cambiano).
SITE_URL=
