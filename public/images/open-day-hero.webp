  </defs>
  <rect width="1600" height="900" fill="url(#sky)"/>
  <rect y="640" width="1600" height="260" fill="url(#floor)"/>
  <g stroke="#141c3a" stroke-width="6" stroke-linecap="round" fill="none">
    <path d="M430 660 L800 660 L800 600" />
    <path d="M1170 660 L800 660 L800 600" />
